[Unit]
Description=Twint REST API Service
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/twint
Environment=TWINT_API_KEY=your-secret-key-here
Environment=TWINT_API_PORT=5000
ExecStart=/opt/twint/venv/bin/gunicorn --bind 0.0.0.0:5000 --workers 2 --timeout 120 api.server:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
